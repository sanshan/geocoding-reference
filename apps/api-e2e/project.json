{
    "name": "@geocoding/api-e2e",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/api-e2e/src",
    "projectType": "application",
    "tags": [],
    "implicitDependencies": ["@geocoding/api"],
    "targets": {
        "fixture-server": {
            "continuous": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node apps/api-e2e/scripts/fixture-server.mjs"
            }
        },
        "api-server": {
            "continuous": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "DATASET_URL=http://127.0.0.1:4301/US.zip pnpm nx run @geocoding/api:serve"
            }
        },
        "e2e": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
            "options": {
                "jestConfig": "apps/api-e2e/jest.config.cts",
                "passWithNoTests": true,
                "runInBand": true
            },
            "dependsOn": [
                {
                    "projects": ["@geocoding/api-e2e"],
                    "target": "fixture-server"
                },
                {
                    "projects": ["@geocoding/api-e2e"],
                    "target": "api-server"
                }
            ]
        }
    }
}
